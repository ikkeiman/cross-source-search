# どの取り込み元を使うか（カンマ区切り）: fake_kintone, local_folder, kintone, dropbox
SOURCES=fake_kintone,local_folder

# kintone（本物を使うときだけ）。アプリ ID はカンマ区切り。値は .env に書き、コミットしない
KINTONE_BASE_URL=https://example.cybozu.com
KINTONE_API_TOKENS=            # app_id:token をカンマ区切り。例 123:xxxx,456:yyyy
KINTONE_APP_IDS=123,456

# Dropbox（本物を使うときだけ）
DROPBOX_ACCESS_TOKEN=
DROPBOX_ROOT_PATH=/shared

# 鍵なしで動かすための代替
FAKE_KINTONE_URL=http://127.0.0.1:8002
LOCAL_FOLDER_PATH=sample_data/files

# 要約と埋め込み（Ollama）。届かなければ要約は先頭抜粋、埋め込みはハッシュに自動で切り替わる
OLLAMA_BASE_URL=http://localhost:11434
SUMMARY_MODEL=qwen2.5:7b-instruct
EMBED_MODEL=bge-m3

# 保存先
DATA_DIR=data
